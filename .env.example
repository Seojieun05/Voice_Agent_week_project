# Grok API configuration (required for /api/chat endpoint)
# Get your key from https://console.x.ai or https://api.x.ai
GROK_API_KEY=your-grok-api-key-here

# Optional: Override Grok API configuration
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_MODEL=grok-4-fast-non-reasoning
# GROK_TIMEOUT_S=20

# Alternative key name (either GROK_API_KEY or XAI_API_KEY works)
# XAI_API_KEY=your-xai-api-key-here

# Vision server configuration (optional)
# VISION_SERVER_MODEL=yolo26s.pt
# VISION_SERVER_CONFIDENCE=0.10
# VISION_SERVER_MAX_QUESTION_LENGTH=500
